<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="cobotta_hand_ros2_control" params="name namespace sim ip_address verbose">
        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${sim}">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:if>
                <xacro:unless value="${sim}">
                    <plugin>denso_robot_control/CobottaHandHW</plugin>
                    <param name="robot_name">CVR038A1</param>
                    <param name="ip_address">${ip_address}</param>
                    <param name="node_name">denso_hand_controller</param>
                    <param name="node_namespace">${namespace}cobotta</param>
                    <param name="joint">cobotta_finger_joint1</param>
                    <param name="send_format">0</param>
                    <param name="recv_format">2</param>
                    <param name="verbose">${verbose}</param>
                </xacro:unless>
            </hardware>

            <xacro:if value="${sim}">
                <joint name="cobotta_finger_joint1">
                    <command_interface name="position" />
                    <state_interface name="position">
                    <param name="initial_value">0.0</param>
                    </state_interface>
                    <state_interface name="velocity">
                        <param name="initial_value">0.0</param>
                    </state_interface>
                </joint>
                <joint name="cobotta_finger_joint2">
                    <param name="mimic">cobotta_finger_joint1</param>
                    <param name="multiplier">-1</param>
                    <state_interface name="position">
                    <param name="initial_value">0.0</param>
                    </state_interface>
                    <state_interface name="velocity">
                        <param name="initial_value">0.0</param>
                    </state_interface>
                </joint>
            </xacro:if>

            <xacro:unless value="${sim}">
                <joint name="cobotta_finger_joint1">
                    <command_interface name="position" />
                    <state_interface name="position">
                    <param name="initial_value">0.0</param>
                    </state_interface>
                    <state_interface name="velocity">
                        <param name="initial_value">0.0</param>
                    </state_interface>
                </joint>
            </xacro:unless>

        </ros2_control>
    </xacro:macro>

</robot>
